<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' · ' : '' %>mini-erp</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <style>
    :root { --ink: #18222d; --muted: #6d7884; --line: #dfe5e8; --paper: #f7f9f8; --surface: #ffffff; --navy: #153a4a; --teal: #138a87; --mint: #d9f1e9; --amber: #e7a93c; --red: #c65a52; --shadow: 0 16px 40px rgba(21, 58, 74, .08); }
    * { box-sizing: border-box; }
    body { margin: 0; color: var(--ink); background: var(--paper); font: 15px/1.55 Georgia, 'Times New Roman', serif; }
    a { color: var(--teal); text-decoration: none; } a:hover { text-decoration: underline; }
    .app-shell { min-height: 100vh; display: grid; grid-template-columns: 232px 1fr; }
    .sidebar { background: var(--navy); color: #eef7f5; padding: 28px 18px; display: flex; flex-direction: column; }
    .brand { display: flex; align-items: center; gap: 10px; color: white; font: 700 20px/1 Georgia, serif; letter-spacing: .02em; margin: 0 10px 40px; }
    .brand-mark { display: grid; place-items: center; width: 31px; height: 31px; border-radius: 9px; background: var(--amber); color: var(--navy); font: 800 17px Arial, sans-serif; }
    .nav-label { color: #8daab0; font: 700 10px Arial, sans-serif; letter-spacing: .13em; text-transform: uppercase; margin: 0 11px 10px; }
    nav { display: grid; gap: 4px; } nav a, .nav-action { border: 0; border-radius: 8px; background: transparent; color: #c9dcda; padding: 11px 12px; text-align: left; font: 600 14px Arial, sans-serif; cursor: pointer; }
    nav a:hover, nav a[aria-current="page"], .nav-action:hover { background: #255568; color: white; text-decoration: none; }
    .sidebar-footer { margin-top: auto; border-top: 1px solid #2d5664; padding: 18px 10px 0; color: #b4cccb; font: 12px Arial, sans-serif; }
    .sidebar-footer strong { display: block; color: white; font-size: 14px; margin-bottom: 3px; }
    .workspace { min-width: 0; } .topbar { height: 76px; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 0 5vw; border-bottom: 1px solid var(--line); background: rgba(255,255,255,.8); }
    .crumb { color: var(--muted); font: 12px Arial, sans-serif; } .crumb strong { color: var(--ink); }
    .quick-actions { display: flex; align-items: center; gap: 10px; font: 600 13px Arial, sans-serif; }
    main { max-width: 1180px; margin: 0 auto; padding: 42px 5vw 72px; }
    h1, h2, h3 { margin: 0; color: var(--navy); } h1 { font-size: clamp(28px, 4vw, 42px); line-height: 1.05; } h2 { font-size: 28px; } h3 { font-size: 18px; } p { color: var(--muted); }
    .page-heading { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 30px; } .eyebrow { color: var(--teal); font: 700 11px Arial, sans-serif; letter-spacing: .14em; text-transform: uppercase; margin: 0 0 10px; }
    .button, button { display: inline-flex; align-items: center; justify-content: center; border: 0; border-radius: 7px; background: var(--teal); color: white; padding: 11px 16px; font: 700 13px Arial, sans-serif; cursor: pointer; } .button:hover, button:hover { background: #0e706d; text-decoration: none; } .button.secondary { background: var(--mint); color: #17645f; } .button.ghost { background: transparent; color: var(--teal); border: 1px solid #acd8d0; }
    .flash { border-left: 4px solid var(--red); background: #fff0ed; color: #8e3934; padding: 13px 16px; margin-bottom: 24px; font: 600 13px Arial, sans-serif; }
    .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(165px, 1fr)); gap: 14px; margin-bottom: 30px; } .stat, .panel { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; box-shadow: var(--shadow); } .stat { padding: 20px; } a.stat:hover { border-color: #acd8d0; text-decoration: none; transform: translateY(-1px); } .stat-label { color: var(--muted); font: 700 11px Arial, sans-serif; letter-spacing: .08em; text-transform: uppercase; } .stat-value { display: block; color: var(--navy); font: 700 32px Georgia, serif; margin-top: 10px; }
    .dashboard-grid { display: grid; grid-template-columns: 1.35fr .85fr; gap: 18px; } .panel { padding: 23px; } .panel-heading { display: flex; align-items: center; justify-content: space-between; gap: 15px; margin-bottom: 18px; } .panel-heading span { color: var(--muted); font: 12px Arial, sans-serif; }
    table { width: 100%; border-collapse: collapse; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; box-shadow: var(--shadow); } th, td { padding: 15px 17px; border-bottom: 1px solid var(--line); text-align: left; } th { color: var(--muted); background: #f3f7f6; font: 700 10px Arial, sans-serif; letter-spacing: .09em; text-transform: uppercase; } tr:last-child td { border-bottom: 0; } td { font-size: 14px; } .table-wrap { overflow-x: auto; }
    .status { display: inline-flex; border-radius: 20px; padding: 5px 9px; font: 700 10px Arial, sans-serif; letter-spacing: .06em; text-transform: uppercase; } .status-draft, .status-pending { color: #866113; background: #fff0cf; } .status-confirmed, .status-paid, .status-received { color: #17645f; background: var(--mint); } .status-ordered { color: #205f82; background: #dceefa; } .status-cancelled { color: #8e3934; background: #ffe3df; }
    .search-row { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 18px; } input, select { width: 100%; border: 1px solid #cbd6d7; border-radius: 6px; background: white; color: var(--ink); padding: 12px 13px; font: 15px Georgia, serif; } input:focus, select:focus { outline: 3px solid #c9eee6; border-color: var(--teal); } .search-input { max-width: 290px; }
    form { max-width: 620px; } form > div, form > fieldset { margin-bottom: 17px; } label { display: block; color: var(--navy); font: 700 12px Arial, sans-serif; margin-bottom: 7px; } fieldset { border: 1px solid var(--line); border-radius: 8px; padding: 18px; } legend { color: var(--navy); font: 700 12px Arial, sans-serif; padding: 0 6px; } .form-actions, .actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; } .actions form { display: inline; margin: 0; }
    .detail-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 18px; } .detail-list { display: grid; gap: 14px; margin: 0; } .detail-list dt { color: var(--muted); font: 700 10px Arial, sans-serif; letter-spacing: .08em; text-transform: uppercase; } .detail-list dd { margin: 2px 0 0; color: var(--navy); font-size: 17px; }
    .empty { padding: 35px 15px; text-align: center; color: var(--muted); } .mobile-menu { display: none; } .muted { color: var(--muted); } .mono { font: 12px ui-monospace, SFMono-Regular, Consolas, monospace; } .positive { color: var(--teal); } .warning { color: #9a6811; } .danger { color: var(--red); } .stack { display: grid; gap: 18px; } .line-items { max-width: none; } .line-item { display: grid; grid-template-columns: 2fr .7fr 1fr; gap: 12px; align-items: end; padding: 14px 0; border-bottom: 1px solid var(--line); } .line-item:last-child { border-bottom: 0; } .helper { margin: 6px 0 0; color: var(--muted); font: 12px Arial, sans-serif; } .timeline { border-left: 2px solid var(--line); margin-left: 7px; padding-left: 20px; } .timeline-item { position: relative; padding: 0 0 18px; } .timeline-item::before { content: ''; position: absolute; width: 10px; height: 10px; border-radius: 50%; left: -26px; top: 6px; background: var(--teal); } .text-right { text-align: right; }
    @media (max-width: 850px) { .app-shell { grid-template-columns: 1fr; } .sidebar { padding: 16px 18px; } .brand { margin: 0; } .sidebar nav, .sidebar .nav-label, .sidebar-footer { display: none; } .mobile-menu { display: block; margin-left: auto; background: #255568; } .sidebar.open nav, .sidebar.open .nav-label, .sidebar.open .sidebar-footer { display: grid; } .sidebar.open .nav-label { margin-top: 24px; } .topbar { height: 62px; padding: 0 18px; } main { padding: 30px 18px 55px; } .stats { grid-template-columns: repeat(2, 1fr); } .dashboard-grid, .detail-grid { grid-template-columns: 1fr; } }
    @media (max-width: 540px) { .page-heading { display: block; } .page-heading .button { margin-top: 18px; } .search-row { display: block; } .search-input { max-width: none; margin-top: 12px; } th, td { padding: 12px; } .line-item { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar" id="sidebar">
      <a class="brand" href="/dashboard"><span class="brand-mark">m</span>mini-erp</a>
      <% if (locals.isAuthenticated) { %>
        <p class="nav-label">Overview</p>
        <nav aria-label="Main navigation">
          <a href="/dashboard" <%= pageTitle === 'Overview' ? 'aria-current="page"' : '' %>>Overview</a>
        </nav>
        <p class="nav-label" style="margin-top:24px">Sales</p>
        <nav aria-label="Sales navigation">
          <a href="/orders" <%= pageTitle === 'Sales orders' ? 'aria-current="page"' : '' %>>Sales orders</a>
          <a href="/invoices" <%= pageTitle === 'Invoices' ? 'aria-current="page"' : '' %>>Invoices</a>
          <a href="/customers" <%= pageTitle === 'Customers' ? 'aria-current="page"' : '' %>>Customers</a>
        </nav>
        <p class="nav-label" style="margin-top:24px">Purchasing & stock</p>
        <nav aria-label="Purchasing navigation">
          <a href="/purchase-orders" <%= pageTitle === 'Purchase orders' ? 'aria-current="page"' : '' %>>Purchase orders</a>
          <a href="/suppliers" <%= pageTitle === 'Suppliers' ? 'aria-current="page"' : '' %>>Suppliers</a>
          <a href="/products" <%= pageTitle === 'Products' ? 'aria-current="page"' : '' %>>Products</a>
        </nav>
        <p class="nav-label" style="margin-top:28px">Actions</p>
        <nav aria-label="Quick actions"><a href="/orders/new">+ Sales order</a><a href="/purchase-orders/new">+ Purchase order</a></nav>
        <div class="sidebar-footer"><strong><%= locals.user?.name || 'Workspace user' %></strong><%= locals.user?.role || 'Staff' %><form action="/logout" method="post" style="margin-top:14px"><button class="nav-action" type="submit">Log out</button></form></div>
      <% } else { %>
        <nav aria-label="Account navigation"><a href="/login">Log in</a><a href="/register">Register</a></nav>
      <% } %>
      <button class="mobile-menu" type="button" aria-label="Toggle navigation" onclick="document.getElementById('sidebar').classList.toggle('open')">Menu</button>
    </aside>
    <div class="workspace">
      <header class="topbar"><span class="crumb"><strong>Operations</strong> / <%= pageTitle || 'Welcome' %></span><div class="quick-actions"><% if (locals.isAuthenticated) { %><a class="button secondary" href="/orders/new">New sale</a><a class="button ghost" href="/purchase-orders/new">New purchase</a><% } %></div></header>
      <main>
    <% if (locals.error) { %>
      <p class="flash" role="alert"><%= error %></p>
    <% } %>
