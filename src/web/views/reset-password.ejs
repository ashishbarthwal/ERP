<%- include('partials/header') %>
  <section class="auth-page">
    <div class="auth-intro"><div class="auth-wordmark"><span class="brand-mark">ME</span><span>mini<span class="auth-wordmark-separator">/</span>erp</span></div><div class="auth-story"><p class="eyebrow">Account recovery</p><h1>A fresh<br /><em>start.</em></h1><p>Choose a new password to protect your workspace account.</p></div><p class="auth-intro-foot">Recovery links expire after 30 minutes.</p></div>
    <section class="panel auth-panel" aria-labelledby="auth-title"><div class="auth-form-heading"><p class="eyebrow">New password</p><h2 id="auth-title">Set a new password</h2><p>Use at least 12 characters.</p></div>
      <% if (error) { %><p class="alert error" role="alert"><%= error %></p><% } %>
      <form action="/reset-password" method="post"><%- include('partials/csrf') %><input type="hidden" name="token" value="<%= token %>" /><div><label for="password">New password</label><input type="password" id="password" name="password" required minlength="12" autocomplete="new-password" /></div><div><label for="confirmPassword">Confirm new password</label><input type="password" id="confirmPassword" name="confirmPassword" required minlength="12" autocomplete="new-password" /></div><button class="button" type="submit">Update password</button></form>
      <p class="auth-switch"><a href="/login">Back to sign in</a></p></section>
  </section>
<%- include('partials/footer') %>
