<% const money = cents => `$${(cents / 100).toFixed(2)}`; const peak = Math.max(1, ...analytics.trend.flatMap(day => [day.invoicedCents, day.collectedCents])); %>
<%- include('partials/header') %>
  <section class="page-heading">
    <div>
      <p class="eyebrow">Business intelligence / Operations</p>
      <h1>Analytics cockpit</h1>
      <p>Live ERP transactions. Period metrics use UTC dates; receivables, commitments and stock are current snapshots.</p>
    </div>
    <a class="button" href="/analytics/export.csv?days=<%= analytics.days %>" data-testid="analytics-export">Export daily CSV</a>
  </section>

  <div class="actions" aria-label="Analytics period" style="margin-bottom:22px">
    <strong>Period</strong>
    <% [7, 30, 90].forEach(function(days) { %>
      <a class="button <%= analytics.days === days ? '' : 'ghost' %>" href="/analytics?days=<%= days %>" <% if (analytics.days === days) { %>aria-current="page"<% } %>><%= days %> days</a>
    <% }) %>
    <span class="muted"><%= analytics.since.slice(0, 10) %> to <%= analytics.until.slice(0, 10) %> UTC</span>
  </div>

  <section class="stats" aria-label="Analytics key performance indicators">
    <div class="stat"><span class="stat-label">Invoiced in period</span><strong class="stat-value" data-testid="analytics-invoiced"><%= money(analytics.invoicedCents) %></strong><small class="muted"><%= analytics.invoiceCount %> invoices created</small></div>
    <div class="stat"><span class="stat-label">Cash collected in period</span><strong class="stat-value" data-testid="analytics-collected"><%= money(analytics.collectedCents) %></strong><small class="muted">Payment posting date</small></div>
    <div class="stat"><span class="stat-label">Open receivables</span><strong class="stat-value" data-testid="analytics-outstanding"><%= money(analytics.outstandingCents) %></strong><small class="muted"><%= money(analytics.overdueCents) %> older than 30 days</small></div>
    <div class="stat"><span class="stat-label">Received purchases</span><strong class="stat-value" data-testid="analytics-received"><%= money(analytics.receivedCostCents) %></strong><small class="muted">At recorded unit cost</small></div>
    <div class="stat"><span class="stat-label">Ordered commitments</span><strong class="stat-value" data-testid="analytics-committed"><%= money(analytics.committedPurchaseCents) %></strong><small class="muted"><%= analytics.openPurchaseCount %> open orders incl. drafts</small></div>
    <div class="stat"><span class="stat-label">Stock alerts</span><strong class="stat-value" data-testid="analytics-low-stock"><%= analytics.lowStockCount %></strong><small class="muted">Fewer than 10 usable units</small></div>
  </section>

  <section class="dashboard-grid">
    <div class="panel">
      <div class="panel-heading"><div><h3>Invoice and cash trend</h3><span>Daily, in the selected period</span></div><span>Invoiced / Collected</span></div>
      <div class="table-wrap"><table><thead><tr><th>Date UTC</th><th>Invoiced</th><th>Collected</th><th style="width:30%">Trend</th></tr></thead><tbody>
        <% analytics.trend.forEach(function(day) { %>
          <tr><td><%= day.date %></td><td><%= money(day.invoicedCents) %></td><td><%= money(day.collectedCents) %></td><td>
            <div style="height:8px;min-width:2px;border-radius:5px;background:var(--teal);width:<%= Math.round(day.invoicedCents / peak * 100) %>%" aria-label="Invoiced <%= money(day.invoicedCents) %>"></div>
            <div style="height:8px;min-width:2px;border-radius:5px;background:var(--amber);width:<%= Math.round(day.collectedCents / peak * 100) %>%;margin-top:4px" aria-label="Collected <%= money(day.collectedCents) %>"></div>
          </td></tr>
        <% }) %>
      </tbody></table></div>
    </div>
    <div class="stack">
      <div class="panel"><div class="panel-heading"><h3>Sales pipeline</h3><span><%= analytics.salesOrderCount %> orders created</span></div>
        <p>Draft <strong><%= analytics.salesStatuses.DRAFT %></strong> · Confirmed <strong><%= analytics.salesStatuses.CONFIRMED %></strong> · Cancelled <strong><%= analytics.salesStatuses.CANCELLED %></strong></p>
        <small class="muted">Grouped by creation date, not confirmation date.</small>
      </div>
      <div class="panel"><div class="panel-heading"><h3>Top invoiced products</h3><span>By invoiced line value</span></div>
        <% if (analytics.topProducts.length) { %>
          <div class="table-wrap"><table><thead><tr><th>Product</th><th>Units</th><th>Value</th></tr></thead><tbody>
            <% analytics.topProducts.forEach(function(product) { %><tr><td><%= product.name %><br><small class="muted"><%= product.sku %></small></td><td><%= product.units %></td><td><%= money(product.revenueCents) %></td></tr><% }) %>
          </tbody></table></div>
        <% } else { %><div class="empty">No invoices in this period.</div><% } %>
      </div>
      <div class="panel"><h3>About these numbers</h3><p>Operational metrics, not general-ledger accounting. Invoicing, collections and purchase receipts are separate events; subtracting them is not a profit calculation. Exported CSV amounts are integer cents for reliable Power BI sums.</p></div>
    </div>
  </section>
<%- include('partials/footer') %>
