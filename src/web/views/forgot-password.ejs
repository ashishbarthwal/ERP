<%- include('partials/header') %>
  <section class="auth-page">
    <div class="auth-intro"><div class="auth-wordmark"><span class="brand-mark">ME</span><span>mini<span class="auth-wordmark-separator">/</span>erp</span></div><div class="auth-story"><p class="eyebrow">Account recovery</p><h1>Get back<br /><em>to work.</em></h1><p>We'll send a secure, time-limited link if the address belongs to an active workspace account.</p></div><p class="auth-intro-foot">Your business data stays protected.</p></div>
    <section class="panel auth-panel" aria-labelledby="auth-title"><div class="auth-form-heading"><p class="eyebrow">Password recovery</p><h2 id="auth-title"><%= sent ? 'Check your inbox' : 'Reset your password' %></h2><p><%= sent ? 'If that address is registered, a recovery link is on its way.' : 'Enter your work email to receive a recovery link.' %></p></div>
      <% if (!sent) { %><form action="/forgot-password" method="post"><%- include('partials/csrf') %><div><label for="email">Work email</label><input type="email" id="email" name="email" autocomplete="email" required /></div><button class="button" type="submit">Send recovery link</button></form><% } %>
      <p class="auth-switch"><a href="/login">Back to sign in</a></p></section>
  </section>
<%- include('partials/footer') %>
