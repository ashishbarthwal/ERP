<% const purchaseCount = supplier.purchaseOrders.length; const openCount = supplier.purchaseOrders.filter(order => order.status === 'DRAFT' || order.status === 'ORDERED').length; const receivedCount = supplier.purchaseOrders.filter(order => order.status === 'RECEIVED').length; %>
<%- include('../partials/header') %>
  <section class="page-heading"><div><p class="eyebrow"><a href="/suppliers">Suppliers</a> / Account</p><h1><%= supplier.name %></h1><p>Supplier account and purchasing history.</p></div><% if (locals.can?.('purchases.write')) { %><a class="button" href="/purchase-orders/new?supplierId=<%= supplier.id %>">New purchase order</a><% } %></section>
  <section class="stats stats-three" aria-label="Supplier summary"><div class="stat"><span class="stat-label">Purchase orders</span><strong class="stat-value"><%= purchaseCount %></strong><small>All-time records</small></div><div class="stat"><span class="stat-label">Open commitments</span><strong class="stat-value warning"><%= openCount %></strong><small>Draft or ordered</small></div><div class="stat"><span class="stat-label">Received</span><strong class="stat-value positive"><%= receivedCount %></strong><small>Stock receipt completed</small></div></section>
  <section class="detail-grid supplier-detail">
    <div class="panel"><div class="panel-heading"><div><p class="eyebrow">Account profile</p><h2>Contact details</h2></div></div><dl class="detail-list"><div><dt>Email</dt><dd><a href="mailto:<%= supplier.email %>"><%= supplier.email %></a></dd></div><div><dt>Phone</dt><dd><%= supplier.phone || 'Not provided' %></dd></div></dl></div>
    <div class="panel"><div class="panel-heading"><div><p class="eyebrow">Procurement</p><h2>Purchase history</h2><p class="section-note"><%= purchaseCount %> purchase order<%= purchaseCount === 1 ? '' : 's' %></p></div><a href="/purchase-orders">Order register</a></div>
      <% if (purchaseCount) { %><div class="table-wrap responsive-summary-wrap"><table class="table-plain responsive-summary-table"><thead><tr><th>Purchase order</th><th>Stage</th><th>Created</th></tr></thead><tbody><% supplier.purchaseOrders.forEach(function (purchaseOrder) { %><tr data-testid="supplier-purchase-order"><td class="mono" data-label="Purchase order"><a href="/purchase-orders/<%= purchaseOrder.id %>" aria-label="Open purchase order <%= purchaseOrder.id %>"><%= purchaseOrder.id.slice(0, 12) %></a></td><td data-label="Stage"><span class="status status-<%= purchaseOrder.status.toLowerCase() %>"><%= purchaseOrder.status %></span></td><td data-label="Created"><%= new Date(purchaseOrder.createdAt).toLocaleDateString('en-US') %></td></tr><% }) %></tbody></table></div><% } else { %><div class="list-empty"><strong>No purchases yet</strong>Create a purchase order to begin this supplier's history.</div><% } %>
    </div>
  </section>
<%- include('../partials/footer') %>
