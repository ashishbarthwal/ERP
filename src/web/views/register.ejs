<%- include('partials/header') %>
  <section class="auth-page user-create-page">
    <div class="auth-intro"><p class="eyebrow">Administration / access</p><h1>Add a teammate</h1><p>Set up their account and choose the role that fits their work.</p></div>
    <section class="panel auth-panel" aria-labelledby="auth-title">
      <div class="panel-heading"><div><p class="eyebrow">Account setup</p><h2 id="auth-title">New user</h2><p class="section-note">Use a work email and a temporary password with at least 8 characters. Share it privately.</p></div></div>
      <form action="/register" method="post">
        <%- include('partials/csrf') %>
        <div><label for="name">Name</label><input type="text" id="name" name="name" value="<%= registerDraft.name %>" required autocomplete="name" <% if (registerFieldErrors.name) { %>aria-invalid="true" aria-describedby="register-name-error" autofocus<% } %> /><% if (registerFieldErrors.name) { %><p class="field-error" id="register-name-error"><%= registerFieldErrors.name %></p><% } %></div>
        <div><label for="email">Email</label><input type="email" id="email" name="email" value="<%= registerDraft.email %>" required autocomplete="email" <% if (registerFieldErrors.email) { %>aria-invalid="true" aria-describedby="register-email-error" <% if (!registerFieldErrors.name) { %>autofocus<% } %><% } %> /><% if (registerFieldErrors.email) { %><p class="field-error" id="register-email-error"><%= registerFieldErrors.email %></p><% } %></div>
        <div><label for="password">Password</label><input type="password" id="password" name="password" required minlength="8" autocomplete="new-password" <% if (registerFieldErrors.password) { %>aria-invalid="true" aria-describedby="register-password-error"<% } %> <% if (error && !registerFieldErrors.name && !registerFieldErrors.email) { %>autofocus<% } %> /><% if (registerFieldErrors.password) { %><p class="field-error" id="register-password-error"><%= registerFieldErrors.password %></p><% } %></div>
        <div><label for="role">Role</label><select id="role" name="role" required><% ['STAFF', 'SALES', 'PURCHASING', 'INVENTORY', 'ADMIN'].forEach(function(role) { %><option value="<%= role %>" <%= registerDraft.role === role ? 'selected' : '' %>><%= role.charAt(0) + role.slice(1).toLowerCase() %></option><% }) %></select><% if (registerFieldErrors.role) { %><p class="field-error"><%= registerFieldErrors.role %></p><% } %></div>
        <button type="submit">Create user</button>
      </form>
      <p class="auth-switch"><a href="/users">Back to users</a></p>
    </section>
  </section>
<%- include('partials/footer') %>
