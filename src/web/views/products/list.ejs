<%- include('../partials/header') %>
  <section class="page-heading"><div><p class="eyebrow">Catalog & inventory</p><h1>Products</h1><p>Manage your catalog, pricing, and available stock.</p></div><a class="button" href="/products/new">+ Add product</a></section>
  <div class="search-row"><strong><%= products.length %> products</strong><input class="search-input" type="search" placeholder="Search SKU or product" data-table-filter="#product-table" /></div>
  <div class="table-wrap"><table id="product-table">
    <thead>
      <tr><th>SKU</th><th>Name</th><th>Price</th><th>On hand</th><th>Reserved</th><th>Usable</th></tr>
    </thead>
    <tbody>
      <% products.forEach(function (product) { %>
        <tr data-filter-row>
          <td><%= product.sku %></td>
          <td><a href="/products/<%= product.id %>"><%= product.name %></a></td>
          <td>$<%= (product.priceCents / 100).toFixed(2) %></td>
          <td><strong><%= product.inventoryItem ? product.inventoryItem.availableQty : 0 %></strong></td>
          <td><%= product.inventoryItem ? product.inventoryItem.reservedQty : 0 %></td>
          <td><strong><%= product.inventoryItem ? product.inventoryItem.availableQty - product.inventoryItem.reservedQty : 0 %></strong></td>
        </tr>
      <% }) %>
    </tbody>
  </table></div>
  <script>document.querySelectorAll('[data-table-filter]').forEach(function (input) { input.addEventListener('input', function () { document.querySelectorAll(input.dataset.tableFilter + ' [data-filter-row]').forEach(function (row) { row.hidden = !row.textContent.toLowerCase().includes(input.value.toLowerCase()); }); }); });</script>
<%- include('../partials/footer') %>
