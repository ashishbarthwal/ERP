<%- include('../partials/header') %>
  <section class="page-heading"><div><p class="eyebrow">Inventory / catalog</p><h1>Products</h1><p>Pricing and stock availability across the catalog.</p></div><% if (locals.can?.('products.write')) { %><a class="button" href="/products/new">Add product</a><% } %></section>
  <section class="list-surface" data-list-view aria-label="Product register">
    <div class="list-toolbar"><strong data-list-count aria-live="polite">Showing <%= products.length %> of <%= products.length %></strong><div class="list-controls"><label>Search products<input type="search" placeholder="Product name or SKU" data-list-search /></label></div></div>
    <% if (products.length) { %><div class="table-wrap"><table id="product-table"><thead><tr><th>Product</th><th>SKU</th><th class="numeric">Sale price</th><th class="numeric">On hand</th><th class="numeric">Reserved</th><th>Usable / reorder point</th></tr></thead><tbody>
      <% products.forEach(function (product) { const onHand = product.inventoryItem?.availableQty ?? 0; const reserved = product.inventoryItem?.reservedQty ?? 0; const usable = onHand - reserved; const threshold = product.reorderPoint; const fill = threshold > 0 ? Math.max(0, Math.min(100, usable / threshold * 100)) : 100; const tone = usable <= 0 && threshold > 0 ? 'progress-critical' : usable < threshold && threshold > 0 ? 'progress-ready' : 'progress-done'; %>
        <tr data-filter-row><td><a class="record-link" href="/products/<%= product.id %>" aria-label="Open product <%= product.name %>, SKU <%= product.sku %>"><%= product.name %></a></td><td class="mono"><%= product.sku %></td><td class="numeric">$<%= (product.priceCents / 100).toFixed(2) %></td><td class="numeric"><%= onHand %></td><td class="numeric"><%= reserved %></td><td><div class="list-stock"><strong><%= usable %> usable / <%= threshold === 0 ? 'alert off' : threshold %></strong><div class="progress-track" role="progressbar" aria-label="<%= product.name %> usable stock against <%= threshold %>-unit alert line" aria-valuemin="0" aria-valuemax="<%= Math.max(1, threshold) %>" aria-valuenow="<%= Math.max(0, Math.min(Math.max(1, threshold), usable)) %>"><span class="progress-segment <%= tone %>" style="width:<%= fill %>%"></span></div></div></td></tr>
      <% }) %>
    </tbody></table></div><div class="list-empty" data-list-no-results hidden><strong>No matching products</strong>Try another name or SKU.</div>
    <% } else { %><div class="list-empty"><strong>No products yet</strong>Add the first product to establish the catalog.</div><% } %>
  </section>
<%- include('../partials/footer') %>
