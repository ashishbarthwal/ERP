<% const movementLabel = (type) => ({ MANUAL_ADDITION: 'Manual addition', PURCHASE_RECEIPT: 'Purchase receipt', ORDER_RESERVATION: 'Sales reservation', ORDER_RELEASE: 'Reservation released', SALE_CONSUMPTION: 'Sale fulfilled' }[type] || type); const usableQty = product.inventoryItem.availableQty - product.inventoryItem.reservedQty; const stockFill = Math.max(0, Math.min(100, usableQty * 10)); const stockTone = usableQty <= 0 ? 'progress-critical' : usableQty < 5 ? 'progress-ready' : usableQty < 10 ? 'progress-draft' : 'progress-done'; %>
<%- include('../partials/header') %>
  <section class="page-heading"><div><p class="eyebrow">Catalog / <%= product.sku %></p><h1><%= product.name %></h1><p><%= product.description || 'No product description.' %></p></div><a class="button secondary" href="/products">Back to products</a></section>

  <section class="stats" aria-label="Product inventory">
    <div class="stat"><span class="stat-label">Sale price</span><strong class="stat-value">$<%= (product.priceCents / 100).toFixed(2) %></strong></div>
    <div class="stat"><span class="stat-label">On hand</span><strong class="stat-value" data-testid="available-qty"><%= product.inventoryItem.availableQty %></strong></div>
    <div class="stat"><span class="stat-label">Reserved</span><strong class="stat-value" data-testid="reserved-qty"><%= product.inventoryItem.reservedQty %></strong></div>
    <div class="stat stat-stock-health"><span class="stat-label">Usable stock</span><strong class="stat-value" data-testid="usable-qty"><%= usableQty %></strong><small><%= usableQty < 10 ? 'Below the 10-unit alert line' : 'At or above alert line' %></small><div class="progress-track" role="progressbar" aria-label="Usable stock against the 10-unit alert line" aria-valuemin="0" aria-valuemax="10" aria-valuenow="<%= Math.max(0, Math.min(10, usableQty)) %>"><span class="progress-segment <%= stockTone %>" style="width:<%= stockFill %>%"></span></div></div>
  </section>

  <section class="detail-grid">
    <% if (locals.can?.('inventory.write')) { %><div class="panel">
      <div class="panel-heading"><div><h3>Manual stock adjustment</h3><span>For corrections and initial stock only</span></div></div>
      <form action="/products/<%= product.id %>/stock" method="post" data-testid="stock-adjustment-form" data-confirm="Add this stock adjustment? Inventory on-hand quantity will change.">
        <%- include('../partials/csrf') %>
        <div><label for="quantity">Quantity to add</label><input type="number" id="quantity" name="quantity" min="1" step="1" value="<%= stockDraft.quantity %>" required <% if (stockFieldError) { %>aria-invalid="true" aria-describedby="stock-quantity-error"<% } %> /><% if (stockFieldError) { %><p class="field-error" id="stock-quantity-error"><%= stockFieldError %></p><% } %></div>
        <div><label for="note">Reason</label><input type="text" id="note" name="note" value="<%= stockDraft.note %>" placeholder="e.g. Opening balance correction" maxlength="160" /></div>
        <button type="submit">Add stock</button>
      </form>
      <p class="helper">Normal replenishment should use a purchase order so the receipt has a supplier trail.</p>
    </div><% } %>

    <div class="panel">
      <div class="panel-heading"><div><h3>Inventory movement ledger</h3><span>Latest 20 changes</span></div></div>
      <% if (product.inventoryMovements.length) { %>
        <div class="table-wrap responsive-summary-wrap"><table class="responsive-summary-table inventory-ledger" data-testid="inventory-ledger"><thead><tr><th>Movement</th><th class="numeric">On-hand change</th><th class="numeric">Reserved change</th><th>When</th></tr></thead><tbody>
          <% product.inventoryMovements.forEach(function (movement) { %>
            <tr data-testid="inventory-movement"><td data-label="Movement"><strong><%= movementLabel(movement.type) %></strong><% if (movement.note) { %><br><small><%= movement.note %></small><% } %><% if (movement.referenceId) { %><br><span class="mono"><%= movement.referenceId.slice(0, 12) %></span><% } %></td><td class="numeric <%= movement.quantityDelta >= 0 ? 'positive' : 'danger' %>" data-label="On-hand change"><%= movement.quantityDelta > 0 ? '+' : '' %><%= movement.quantityDelta %></td><td class="numeric <%= movement.reservedDelta > 0 ? 'warning' : (movement.reservedDelta < 0 ? 'positive' : '') %>" data-label="Reserved change"><%= movement.reservedDelta > 0 ? '+' : '' %><%= movement.reservedDelta %></td><td data-label="When"><%= new Date(movement.createdAt).toLocaleString() %></td></tr>
          <% }) %>
        </tbody></table></div>
      <% } else { %><div class="empty">No recorded stock movements yet.</div><% } %>
    </div>
  </section>
<%- include('../partials/footer') %>
