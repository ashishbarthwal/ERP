<% const money = cents => `$${(cents / 100).toFixed(2)}`; const total = purchaseOrder.items.reduce((sum, item) => sum + item.quantity * item.unitCostCents, 0); const units = purchaseOrder.items.reduce((sum, item) => sum + item.quantity, 0); const receivedUnits = purchaseOrder.items.reduce((sum, item) => sum + item.receivedQty, 0); const progress = units ? Math.round(receivedUnits / units * 100) : 0; %>
<%- include('../partials/header') %>
  <article class="document-page">
    <header class="document-header">
      <div class="document-heading">
        <div><p class="eyebrow"><a href="/purchase-orders">Purchase orders</a> / Document</p><h1>Purchase order <span class="document-id"><%= purchaseOrder.id.slice(0, 12) %></span><span class="print-only print-document-id"><%= purchaseOrder.id %></span></h1></div>
        <div class="document-actions" data-testid="purchase-order-actions">
          <% if (purchaseOrder.status === 'DRAFT' && locals.can?.('purchases.write')) { %><form action="/purchase-orders/<%= purchaseOrder.id %>/submit" method="post" data-confirm="Submit this purchase order to the supplier workflow?"><%- include('../partials/csrf') %><button type="submit">Submit order</button></form><% } %>
          <% if ((purchaseOrder.status === 'ORDERED' || purchaseOrder.status === 'PARTIALLY_RECEIVED') && locals.can?.('purchases.receive')) { %><a class="button" href="#receipt-entry">Record receipt</a><% } %>
          <% if ((purchaseOrder.status === 'DRAFT' || purchaseOrder.status === 'ORDERED' || purchaseOrder.status === 'PARTIALLY_RECEIVED') && locals.can?.('purchases.write')) { %><form action="/purchase-orders/<%= purchaseOrder.id %>/cancel" method="post" data-confirm="Cancel this purchase order? Any stock already received stays on hand." data-confirm-tone="danger"><%- include('../partials/csrf') %><button class="button ghost" type="submit">Cancel remaining</button></form><% } %>
          <% if (purchaseOrder.status === 'RECEIVED') { %><a class="button secondary" href="#contents">Review received items</a><% } %>
          <button class="button ghost" type="button" data-print-document aria-label="Print purchase order">Print</button>
        </div>
      </div>
      <dl class="document-facts">
        <div><dt>Supplier</dt><dd><a href="/suppliers/<%= purchaseOrder.supplier.id %>"><%= purchaseOrder.supplier.name %></a></dd></div>
        <div><dt>Order total</dt><dd data-testid="purchase-order-total"><%= money(total) %></dd></div>
        <div><dt>Stage</dt><dd><span class="status status-<%= purchaseOrder.status.toLowerCase() %>" data-testid="purchase-order-status"><%= purchaseOrder.status %></span></dd></div>
        <div><dt>Units received</dt><dd><%= receivedUnits %> / <%= units %></dd></div>
      </dl>
      <% if (purchaseOrder.status === 'CANCELLED') { %><p class="section-note"><%= receivedUnits ? `This purchase was cancelled after ${receivedUnits} of ${units} units arrived. Received stock remains in inventory; outstanding units will not be received.` : 'This purchase order was cancelled before receipt.' %></p><% } else { %>
        <div class="document-progress"><span>Draft</span><div class="progress-track" role="progressbar" aria-label="Purchase order quantities received" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= progress %>"><span class="progress-segment <%= progress === 100 ? 'progress-done' : 'progress-ready' %>" style="width:<%= progress %>%"></span></div><span><%= receivedUnits %> / <%= units %> received</span></div>
      <% } %>
    </header>
    <nav class="document-tabs" aria-label="Purchase order sections"><a href="#contents">Contents</a><a href="#details">Details</a></nav>
    <section class="document-section" id="contents">
      <h2>Line items</h2><p class="section-note"><%= receivedUnits ? 'Received quantities increase inventory as each delivery is recorded. Open a product to inspect its movement ledger.' : 'Stock is added only when a delivery is received. Unit costs are captured on the document.' %></p>
      <% if ((purchaseOrder.status === 'ORDERED' || purchaseOrder.status === 'PARTIALLY_RECEIVED') && locals.can?.('purchases.receive')) { %>
      <form id="receipt-entry" action="/purchase-orders/<%= purchaseOrder.id %>/receive" method="post" data-testid="purchase-receipt-form" data-confirm="Record these delivered quantities? On-hand stock will increase by the amounts entered.">
        <%- include('../partials/csrf') %><input type="hidden" name="receiptIdempotencyKey" value="<%= locals.receiptIdempotencyKey || '' %>" />
        <div class="table-wrap"><table class="table-plain document-lines"><thead><tr><th>Product</th><th class="numeric">Ordered</th><th class="numeric">Received</th><th class="numeric">Remaining</th><th class="numeric">Delivering now</th></tr></thead><tbody>
          <% purchaseOrder.items.forEach(function(item) { const remaining = item.quantity - item.receivedQty; %><tr data-testid="purchase-order-item"><td data-label="Product"><a href="/products/<%= item.product.id %>"><%= item.product.name %></a><br><span class="mono"><%= item.product.sku %></span></td><td data-label="Ordered" class="numeric"><%= item.quantity %></td><td data-label="Received" class="numeric"><%= item.receivedQty %></td><td data-label="Remaining" class="numeric"><%= remaining %></td><td data-label="Delivering now" class="numeric"><input aria-label="Receive <%= item.product.name %> now" type="number" name="received[<%= item.id %>]" min="0" max="<%= remaining %>" value="<%= remaining %>" step="1" required <%= remaining === 0 ? 'disabled' : '' %> /></td></tr><% }) %>
        </tbody></table></div>
        <button type="submit">Record delivered quantities</button>
      </form>
      <% } else { %>
      <div class="table-wrap"><table class="table-plain document-lines"><thead><tr><th>No.</th><th>Product</th><th>SKU</th><th class="numeric">Ordered</th><th class="numeric">Received</th><th class="numeric">Unit cost</th><th class="numeric">Line total</th></tr></thead><tbody>
        <% purchaseOrder.items.forEach(function(item, index) { %><tr data-testid="purchase-order-item"><td data-label="Line"><%= index + 1 %></td><td data-label="Product"><a href="/products/<%= item.product.id %>"><%= item.product.name %></a></td><td data-label="SKU" class="mono"><%= item.product.sku %></td><td data-label="Ordered" class="numeric"><%= item.quantity %></td><td data-label="Received" class="numeric"><%= item.receivedQty %></td><td data-label="Unit cost" class="numeric"><%= money(item.unitCostCents) %></td><td data-label="Line total" class="numeric"><strong><%= money(item.quantity * item.unitCostCents) %></strong></td></tr><% }) %>
      </tbody></table></div>
      <% } %>
      </tbody></table></div>
      <div class="document-total"><div><span><%= purchaseOrder.items.length %> product lines · <%= units %> units</span><strong><%= money(total) %></strong></div><div><strong>Order total</strong><strong><%= money(total) %></strong></div></div>
    </section>
    <% if (purchaseOrder.receipts?.length) { %><section class="document-section" id="receipt-history"><h2>Receipt history</h2><div class="table-wrap"><table class="table-plain"><thead><tr><th>Received</th><th>Items in this receipt</th><th class="numeric">Units</th></tr></thead><tbody><% purchaseOrder.receipts.forEach(function(receipt) { const receiptUnits = receipt.items.reduce((sum, line) => sum + line.quantity, 0); %><tr><td data-label="Received"><%= new Date(receipt.createdAt).toLocaleString() %></td><td data-label="Items"><% receipt.items.forEach(function(line) { %><div><%= line.purchaseOrderItem.product.name %> × <%= line.quantity %></div><% }) %></td><td class="numeric" data-label="Units"><%= receiptUnits %></td></tr><% }) %></tbody></table></div></section><% } %>
    <section class="document-section" id="details">
      <h2>Document details</h2>
      <dl class="document-meta"><div><dt>Created</dt><dd><%= new Date(purchaseOrder.createdAt).toLocaleString() %></dd></div><div><dt>Submitted</dt><dd><%= purchaseOrder.orderedAt ? new Date(purchaseOrder.orderedAt).toLocaleString() : 'Not submitted' %></dd></div><div><dt>Received</dt><dd><%= purchaseOrder.receivedAt ? new Date(purchaseOrder.receivedAt).toLocaleString() : 'Not received' %></dd></div></dl>
    </section>
  </article>
<%- include('../partials/footer') %>
