<% const money = (cents) => `$${(cents / 100).toFixed(2)}`; %>
<%- include('../partials/header') %>
  <section class="page-heading"><div><p class="eyebrow">Procure to stock</p><h1>Purchase orders</h1><p>Order products from suppliers and receive them into inventory.</p></div><a class="button" href="/purchase-orders/new">+ New purchase order</a></section>
  <section class="stats" aria-label="Purchase order summary"><div class="stat"><span class="stat-label">Draft</span><strong class="stat-value"><%= purchaseOrders.filter((po) => po.status === 'DRAFT').length %></strong></div><div class="stat"><span class="stat-label">Awaiting receipt</span><strong class="stat-value warning" data-testid="ordered-po-count"><%= purchaseOrders.filter((po) => po.status === 'ORDERED').length %></strong></div><div class="stat"><span class="stat-label">Received</span><strong class="stat-value positive"><%= purchaseOrders.filter((po) => po.status === 'RECEIVED').length %></strong></div></section>
  <div class="search-row"><strong><%= purchaseOrders.length %> purchase orders</strong><input class="search-input" type="search" placeholder="Search supplier or status" data-table-filter="#purchase-order-table" /></div>
  <div class="table-wrap"><table id="purchase-order-table"><thead><tr><th>Supplier</th><th>Lines</th><th>Status</th><th>Value</th><th>Created</th><th></th></tr></thead><tbody>
    <% purchaseOrders.forEach(function (purchaseOrder) { const total = purchaseOrder.items.reduce((sum, item) => sum + item.quantity * item.unitCostCents, 0); %><tr data-filter-row data-testid="purchase-order-row"><td><strong><%= purchaseOrder.supplier.name %></strong><br><span class="mono"><%= purchaseOrder.id.slice(0, 12) %></span></td><td><%= purchaseOrder.items.length %></td><td><span class="status status-<%= purchaseOrder.status.toLowerCase() %>"><%= purchaseOrder.status %></span></td><td><%= money(total) %></td><td><%= new Date(purchaseOrder.createdAt).toLocaleDateString() %></td><td><a href="/purchase-orders/<%= purchaseOrder.id %>">Open &rarr;</a></td></tr><% }) %>
  </tbody></table></div>
  <% if (!purchaseOrders.length) { %><div class="panel empty">No purchase orders yet. Create one to begin replenishing inventory.</div><% } %>
  <script>document.querySelectorAll('[data-table-filter]').forEach(function (input) { input.addEventListener('input', function () { document.querySelectorAll(input.dataset.tableFilter + ' [data-filter-row]').forEach(function (row) { row.hidden = !row.textContent.toLowerCase().includes(input.value.toLowerCase()); }); }); });</script>
<%- include('../partials/footer') %>
