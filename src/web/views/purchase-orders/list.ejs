<% const money = (cents) => `$${(cents / 100).toFixed(2)}`; %>
<%- include('../partials/header') %>
  <section class="page-heading"><div><p class="eyebrow">Purchasing / commitments</p><h1>Purchase orders</h1><p>Supplier orders and receipts in one register.</p></div><% if (locals.can?.('purchases.write')) { %><a class="button" href="/purchase-orders/new">New purchase order</a><% } %></section>
  <section class="stats" aria-label="Purchase order summary"><div class="stat"><span class="stat-label">Draft</span><strong class="stat-value"><%= purchaseOrders.filter((po) => po.status === 'DRAFT').length %></strong></div><div class="stat"><span class="stat-label">Awaiting receipt</span><strong class="stat-value warning" data-testid="ordered-po-count"><%= purchaseOrders.filter((po) => po.status === 'ORDERED').length %></strong></div><div class="stat"><span class="stat-label">Received</span><strong class="stat-value positive"><%= purchaseOrders.filter((po) => po.status === 'RECEIVED').length %></strong></div></section>
  <section class="list-surface" data-list-view aria-label="Purchase order register">
    <div class="list-toolbar"><strong data-list-count aria-live="polite">Showing <%= purchaseOrders.length %> of <%= purchaseOrders.length %></strong><div class="list-controls"><label>Search purchases<input type="search" placeholder="Supplier or order ID" data-list-search /></label><label>Stage<select data-list-status><option value="">All stages</option><option value="DRAFT">Draft</option><option value="ORDERED">Ordered</option><option value="RECEIVED">Received</option><option value="CANCELLED">Cancelled</option></select></label></div></div>
    <% if (purchaseOrders.length) { %><div class="table-wrap"><table id="purchase-order-table"><thead><tr><th>Order / supplier</th><th>Created</th><th class="numeric">Lines</th><th class="numeric">Value</th><th>Stage</th></tr></thead><tbody>
      <% purchaseOrders.forEach(function (purchaseOrder) { const total = purchaseOrder.items.reduce((sum, item) => sum + item.quantity * item.unitCostCents, 0); %><tr data-filter-row data-status="<%= purchaseOrder.status %>" data-testid="purchase-order-row"><td><a class="record-link" href="/purchase-orders/<%= purchaseOrder.id %>" aria-label="Open purchase order <%= purchaseOrder.id %> for <%= purchaseOrder.supplier.name %>"><%= purchaseOrder.supplier.name %></a><span class="record-subline mono"><%= purchaseOrder.id.slice(0, 12) %></span></td><td><%= new Date(purchaseOrder.createdAt).toLocaleDateString('en-US') %></td><td class="numeric"><%= purchaseOrder.items.length %></td><td class="numeric"><%= money(total) %></td><td><span class="status status-<%= purchaseOrder.status.toLowerCase() %>"><%= purchaseOrder.status %></span></td></tr><% }) %>
    </tbody></table></div><div class="list-empty" data-list-no-results hidden><strong>No matching purchases</strong>Try another search or stage.</div>
    <% } else { %><div class="list-empty"><strong>No purchase orders yet</strong>Create a purchase order to begin replenishing stock.</div><% } %>
  </section>
<%- include('../partials/footer') %>
