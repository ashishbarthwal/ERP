<% const money = (cents) => `$${(cents / 100).toFixed(2)}`; const total = order.items.reduce((sum, item) => sum + item.quantity * item.unitPriceCents, 0); %>
<%- include('../partials/header') %>
  <section class="page-heading"><div><p class="eyebrow">Sales order</p><h1><span class="mono"><%= order.id.slice(0, 12) %></span></h1><p>Customer: <a href="/customers/<%= order.customer.id %>"><strong><%= order.customer.name %></strong></a> · Created <%= new Date(order.createdAt).toLocaleDateString() %></p></div><span class="status status-<%= order.status.toLowerCase() %>" data-testid="order-status"><%= order.status %></span></section>
  <section class="stats" aria-label="Order summary"><div class="stat"><span class="stat-label">Order value</span><strong class="stat-value" data-testid="order-total"><%= money(total) %></strong></div><div class="stat"><span class="stat-label">Product lines</span><strong class="stat-value"><%= order.items.length %></strong></div><div class="stat"><span class="stat-label">Units</span><strong class="stat-value"><%= order.items.reduce((sum, item) => sum + item.quantity, 0) %></strong></div></section>
  <section class="detail-grid">
    <div class="panel"><div class="panel-heading"><div><h3>Workflow</h3><span>Draft → confirmed → invoiced</span></div></div><dl class="detail-list"><div><dt>Created</dt><dd><%= new Date(order.createdAt).toLocaleString() %></dd></div><div><dt>Confirmed</dt><dd><%= order.confirmedAt ? new Date(order.confirmedAt).toLocaleString() : 'Not confirmed' %></dd></div><div><dt>Invoice</dt><dd><%= order.invoice ? 'Generated' : 'Not generated' %></dd></div></dl>
      <div class="actions" style="margin-top:24px" data-testid="sales-order-actions"><% if (order.status === 'DRAFT') { %><form action="/orders/<%= order.id %>/confirm" method="post"><button type="submit">Confirm & reserve stock</button></form><% } %><% if (order.status !== 'CANCELLED' && !order.invoice) { %><form action="/orders/<%= order.id %>/cancel" method="post"><button class="button ghost" type="submit">Cancel order</button></form><% } %><% if (order.status === 'CONFIRMED' && !order.invoice) { %><form action="/orders/<%= order.id %>/invoice" method="post"><button type="submit">Fulfill & generate invoice</button></form><% } %><% if (order.invoice) { %><a class="button secondary" href="/invoices/<%= order.invoice.id %>">View invoice</a><% } %></div>
    </div>
    <div class="panel"><div class="panel-heading"><div><h3>Products</h3><span>Sale prices captured when drafted</span></div></div><div class="table-wrap"><table><thead><tr><th>Product</th><th>Qty</th><th>Unit price</th><th>Total</th></tr></thead><tbody><% order.items.forEach(function (item) { %><tr data-testid="sales-order-item"><td><a href="/products/<%= item.product.id %>"><%= item.product.name %></a><br><small><%= item.product.sku %></small></td><td><%= item.quantity %></td><td><%= money(item.unitPriceCents) %></td><td><strong><%= money(item.quantity * item.unitPriceCents) %></strong></td></tr><% }) %></tbody></table></div></div>
  </section>
<%- include('../partials/footer') %>
