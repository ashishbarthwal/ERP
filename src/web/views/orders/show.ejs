<% const money = cents => `$${(cents / 100).toFixed(2)}`; const total = order.items.reduce((sum, item) => sum + item.quantity * item.unitPriceCents, 0); const units = order.items.reduce((sum, item) => sum + item.quantity, 0); const stage = order.invoice ? 'INVOICED' : order.status; const progress = order.invoice ? 100 : order.status === 'CONFIRMED' ? 50 : 0; %>
<%- include('../partials/header') %>
  <article class="document-page">
    <header class="document-header">
      <div class="document-heading">
        <div><p class="eyebrow"><a href="/orders">Sales orders</a> / Document</p><h1>Sales order <span class="document-id"><%= order.id.slice(0, 12) %></span><span class="print-only print-document-id"><%= order.id %></span></h1></div>
        <div class="document-actions" data-testid="sales-order-actions">
          <% if (order.status === 'DRAFT' && locals.can?.('orders.write')) { %><form action="/orders/<%= order.id %>/confirm" method="post" data-confirm="Confirm this order and reserve the required stock?"><%- include('../partials/csrf') %><button type="submit">Confirm & reserve</button></form><% } %>
          <% if (order.status === 'CONFIRMED' && !order.invoice && locals.can?.('invoices.write')) { %><form action="/orders/<%= order.id %>/invoice" method="post" data-confirm="Fulfill this order and issue its invoice? Reserved stock will be consumed."><%- include('../partials/csrf') %><button type="submit">Fulfill & invoice</button></form><% } %>
          <% if (order.invoice) { %><a class="button secondary" href="/invoices/<%= order.invoice.id %>">Open invoice</a><% } %>
          <% if (order.status !== 'CANCELLED' && !order.invoice && locals.can?.('orders.write')) { %><form action="/orders/<%= order.id %>/cancel" method="post" data-confirm="Cancel this sales order? This action cannot be undone." data-confirm-tone="danger"><%- include('../partials/csrf') %><button class="button ghost" type="submit">Cancel order</button></form><% } %>
          <button class="button ghost" type="button" data-print-document aria-label="Print sales order">Print</button>
        </div>
      </div>
      <dl class="document-facts">
        <div><dt>Customer</dt><dd><a href="/customers/<%= order.customer.id %>"><%= order.customer.name %></a></dd></div>
        <div><dt>Order total</dt><dd data-testid="order-total"><%= money(total) %></dd></div>
        <div><dt>Stage</dt><dd><span class="status status-<%= order.invoice ? 'paid' : order.status.toLowerCase() %>" data-testid="order-status"><%= stage %></span></dd></div>
        <div><dt>Invoice</dt><dd><% if (order.invoice) { %><a href="/invoices/<%= order.invoice.id %>"><%= order.invoice.id.slice(0, 12) %></a><% } else { %>Not issued<% } %></dd></div>
      </dl>
      <% if (order.status === 'CANCELLED') { %><p class="section-note">This order was cancelled before invoicing.</p><% } else { %>
        <div class="document-progress"><span>Draft</span><div class="progress-track" role="progressbar" aria-label="Sales order workflow" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= progress %>"><span class="progress-segment <%= order.invoice ? 'progress-done' : 'progress-ready' %>" style="width:<%= progress %>%"></span></div><span>Confirmed</span><span>Invoiced</span></div>
      <% } %>
    </header>
    <nav class="document-tabs" aria-label="Sales order sections"><a href="#contents">Contents</a><a href="#details">Details</a></nav>
    <section class="document-section" id="contents">
      <h2>Line items</h2><p class="section-note">Sale prices are captured when this order is drafted.</p>
      <div class="table-wrap"><table class="table-plain document-lines"><thead><tr><th>No.</th><th>Product</th><th>SKU</th><th class="numeric">Quantity</th><th class="numeric">Unit price</th><th class="numeric">Line total</th></tr></thead><tbody>
        <% order.items.forEach(function(item, index) { %><tr data-testid="sales-order-item"><td data-label="Line"><%= index + 1 %></td><td data-label="Product"><a href="/products/<%= item.product.id %>"><%= item.product.name %></a></td><td data-label="SKU" class="mono"><%= item.product.sku %></td><td data-label="Quantity" class="numeric"><%= item.quantity %></td><td data-label="Unit price" class="numeric"><%= money(item.unitPriceCents) %></td><td data-label="Line total" class="numeric"><strong><%= money(item.quantity * item.unitPriceCents) %></strong></td></tr><% }) %>
      </tbody></table></div>
      <div class="document-total"><div><span><%= order.items.length %> product lines · <%= units %> units</span><strong><%= money(total) %></strong></div><div><strong>Order total</strong><strong><%= money(total) %></strong></div></div>
    </section>
    <section class="document-section" id="details">
      <h2>Document details</h2>
      <dl class="document-meta"><div><dt>Created</dt><dd><%= new Date(order.createdAt).toLocaleString() %></dd></div><div><dt>Confirmed</dt><dd><%= order.confirmedAt ? new Date(order.confirmedAt).toLocaleString() : 'Not confirmed' %></dd></div><div><dt>Fulfillment</dt><dd><%= order.invoice ? 'Invoiced; reserved stock consumed' : 'Not yet invoiced' %></dd></div></dl>
    </section>
  </article>
<%- include('../partials/footer') %>
