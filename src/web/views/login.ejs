<%- include('partials/header') %>
  <section class="auth-page">
    <div class="auth-intro">
      <div class="auth-wordmark"><span class="brand-mark">ME</span><span>mini<span class="auth-wordmark-separator">/</span>erp</span></div>
      <div class="auth-story">
        <p class="eyebrow">Your operations workspace</p>
        <h1>Run the day<br /><em>with clarity.</em></h1>
        <p>Sales, purchasing, inventory, and billing in one connected workspace.</p>
        <div class="auth-flow" aria-label="Connected operations: sales, stock, and billing">
          <span><b>01</b> Sales orders</span><span><b>02</b> Stock &amp; purchasing</span><span><b>03</b> Invoices</span>
        </div>
      </div>
      <p class="auth-intro-foot">One place for the work behind every order.</p>
    </div>
    <section class="panel auth-panel" aria-labelledby="auth-title">
      <div class="auth-form-heading"><p class="eyebrow">Secure workspace access</p><h2 id="auth-title">Welcome back</h2><p>Enter your account details to continue.</p></div>
      <form action="/login" method="post">
        <%- include('partials/csrf') %>
        <div><label for="email">Work email</label><input type="email" id="email" name="email" placeholder="name@company.com" value="<%= loginDraft.email %>" required autocomplete="email" <% if (loginFieldErrors.email) { %>aria-invalid="true" aria-describedby="login-email-error" autofocus<% } %> /><% if (loginFieldErrors.email) { %><p class="field-error" id="login-email-error"><%= loginFieldErrors.email %></p><% } %></div>
        <div><label for="password">Password</label><input type="password" id="password" name="password" required autocomplete="current-password" <% if (loginFieldErrors.password) { %>aria-invalid="true" aria-describedby="login-password-error"<% } %> <% if (error && !loginFieldErrors.email) { %>autofocus<% } %> /><% if (loginFieldErrors.password) { %><p class="field-error" id="login-password-error"><%= loginFieldErrors.password %></p><% } %></div>
        <button type="submit">Sign in <span aria-hidden="true">→</span></button>
      </form>
      <p class="auth-switch">Need access? Contact your workspace administrator.</p>
    </section>
  </section>
<%- include('partials/footer') %>
